rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email == 'ekgus899@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    function isValidCategory(category) {
      return category is string && (
        category == '사진 합성' ||
        category == '스타일 변환' ||
        category == '캐릭터·포스터'
      );
    }

    function isValidPrompt(data) {
      return data.keys().hasAll(['title', 'category', 'content', 'createdAt']) &&
        data.keys().hasOnly(['title', 'category', 'content', 'createdAt']) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        isValidCategory(data.category) &&
        data.content is string && data.content.size() >= 1 && data.content.size() <= 20000 &&
        data.createdAt is timestamp;
    }

    // Connection check endpoint (read-only single doc)
    match /test/connection {
      allow get: if true;
    }

    // Prompt warehouse collection: public read for guests, admin-only writes
    match /prompts/{promptId} {
      allow get: if isValidId(promptId);
      allow list: if !('limit' in request.query) || request.query.limit <= 200;
      allow create: if isAdmin() &&
        isValidId(promptId) &&
        isValidPrompt(incoming()) &&
        incoming().createdAt == request.time;
      allow update: if isAdmin() &&
        isValidId(promptId) &&
        isValidPrompt(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'category', 'content']);
      allow delete: if isAdmin() && isValidId(promptId);
    }
  }
}
